import ClassicalMechanics.Noether
import Mathlib.Analysis.Calculus.FDeriv.Symmetric

/-!
# Hamiltonian mechanics

Phase space is `ℝⁿ × ℝⁿ ∋ (q, p)`. An **observable** `F(q, p)` has gradients `F_q`, `F_p`; a
**Hamiltonian** `H` generates **Hamilton's equations**

`q̇ = H_p(q, p)`,  `ṗ = -H_q(q, p)`

([Arnold1989], §§15–16, 40; [Goldstein2002], §§8.1, 9.5).

* **Poisson brackets** `{F, G} = F_q · G_p - F_p · G_q` are antisymmetric (`bracket_antisymm`),
  and observables evolve by `Ḟ = {F, H}` (`hasDerivAt_observable`); hence `F` is a constant of
  the motion iff `{F, H} = 0` along it (`conserved_of_bracket`), and **energy is conserved**
  (`energy_const`).
* **Liouville's theorem** (infinitesimal form, `liouville`): for `H` of class `C²`, the Hamiltonian
  vector field `X_H = (H_p, -H_q)` is **divergence-free**, by symmetry of second derivatives; its
  flow therefore preserves phase-space volume.
* **Natural systems** (`natural_newton`): for `H = |p|²/(2m) + U(q)`, Hamilton's equations
  are `q̇ = p/m`, `ṗ = -∇U`, i.e. Newton's law `m q̈ = -∇U(q)`.

## References

* [Arnold1989] V. I. Arnold, *Mathematical Methods of Classical Mechanics*, §§15–16, 40.
* [Goldstein2002] H. Goldstein, C. Poole, J. Safko, *Classical Mechanics*, 3rd ed., §§8.1, 9.5.
-/

open Matrix

noncomputable section

namespace ClassicalMechanics

variable {n : ℕ}

/-- An **observable** on phase space with its gradients. -/
structure Observable (n : ℕ) where
  F : (Fin n → ℝ) → (Fin n → ℝ) → ℝ
  Fq : (Fin n → ℝ) → (Fin n → ℝ) → Fin n → ℝ
  Fp : (Fin n → ℝ) → (Fin n → ℝ) → Fin n → ℝ
  hasFDerivAt : ∀ q p, HasFDerivAt (fun z : (Fin n → ℝ) × (Fin n → ℝ) => F z.1 z.2)
    ((dotCLM (Fq q p)).comp (ContinuousLinearMap.fst ℝ _ _) +
      (dotCLM (Fp q p)).comp (ContinuousLinearMap.snd ℝ _ _)) (q, p)

namespace Observable

/-- The **Poisson bracket** `{F, G} = F_q · G_p - F_p · G_q`. -/
def bracket (F G : Observable n) (q p : Fin n → ℝ) : ℝ :=
  F.Fq q p ⬝ᵥ G.Fp q p - F.Fp q p ⬝ᵥ G.Fq q p

theorem bracket_antisymm (F G : Observable n) (q p : Fin n → ℝ) :
    F.bracket G q p = -G.bracket F q p := by
  simp only [bracket, dotProduct_comm (F.Fq q p), dotProduct_comm (F.Fp q p)]
  ring

theorem bracket_self (F : Observable n) (q p : Fin n → ℝ) : F.bracket F q p = 0 := by
  have := F.bracket_antisymm F q p
  linarith

end Observable

/-- A motion in phase space generated by the Hamiltonian `H`: Hamilton's equations. -/
structure HamiltonianFlow (H : Observable n) where
  q : ℝ → Fin n → ℝ
  p : ℝ → Fin n → ℝ
  hasDerivAt_q : ∀ t, HasDerivAt q (H.Fp (q t) (p t)) t
  hasDerivAt_p : ∀ t, HasDerivAt p (-H.Fq (q t) (p t)) t

namespace HamiltonianFlow

variable {H : Observable n} (γ : HamiltonianFlow H)

/-- **Evolution of observables**: `Ḟ = {F, H}`. -/
theorem hasDerivAt_observable (F : Observable n) (t : ℝ) :
    HasDerivAt (fun s => F.F (γ.q s) (γ.p s)) (F.bracket H (γ.q t) (γ.p t)) t := by
  have h := (F.hasFDerivAt (γ.q t) (γ.p t)).comp_hasDerivAt t
    ((γ.hasDerivAt_q t).prodMk (γ.hasDerivAt_p t))
  convert h using 1
  · rfl
  simp [Observable.bracket, dotProduct_neg]
  ring

/-- An observable whose bracket with `H` vanishes along the motion is a **constant of the
motion**. -/
theorem conserved_of_bracket (F : Observable n) (hF : ∀ t, F.bracket H (γ.q t) (γ.p t) = 0)
    (s t : ℝ) : F.F (γ.q s) (γ.p s) = F.F (γ.q t) (γ.p t) :=
  eq_of_hasDerivAt_zero (fun t => hF t ▸ γ.hasDerivAt_observable F t) s t

/-- **Conservation of energy**: `Ḣ = {H, H} = 0`. -/
theorem energy_const (s t : ℝ) : H.F (γ.q s) (γ.p s) = H.F (γ.q t) (γ.p t) :=
  γ.conserved_of_bracket H (fun _ => H.bracket_self _ _) s t

end HamiltonianFlow

/-! ### Liouville's theorem -/

section Liouville

variable {H : (Fin n → ℝ) × (Fin n → ℝ) → ℝ}

/-- `∂H/∂qᵢ`. -/
def dq (H : (Fin n → ℝ) × (Fin n → ℝ) → ℝ) (i : Fin n) (z : (Fin n → ℝ) × (Fin n → ℝ)) : ℝ :=
  fderiv ℝ H z (Pi.single i 1, 0)

/-- `∂H/∂pᵢ`. -/
def dp (H : (Fin n → ℝ) × (Fin n → ℝ) → ℝ) (i : Fin n) (z : (Fin n → ℝ) × (Fin n → ℝ)) : ℝ :=
  fderiv ℝ H z (0, Pi.single i 1)

/-- The divergence of the Hamiltonian vector field `X_H = (H_p, -H_q)`:
`Σᵢ ∂(∂H/∂pᵢ)/∂qᵢ - ∂(∂H/∂qᵢ)/∂pᵢ`. -/
def hamDiv (H : (Fin n → ℝ) × (Fin n → ℝ) → ℝ) (z : (Fin n → ℝ) × (Fin n → ℝ)) : ℝ :=
  ∑ i, (fderiv ℝ (dp H i) z (Pi.single i 1, 0) - fderiv ℝ (dq H i) z (0, Pi.single i 1))

/-- **Liouville's theorem** (infinitesimal form): the Hamiltonian vector field of a `C²`
Hamiltonian is divergence-free, so its flow preserves phase-space volume. -/
theorem liouville (hH : ContDiff ℝ 2 H) (z : (Fin n → ℝ) × (Fin n → ℝ)) : hamDiv H z = 0 := by
  have hD : Differentiable ℝ (fderiv ℝ H) :=
    (hH.fderiv_right (m := 1) (by norm_num)).differentiable one_ne_zero
  have key : ∀ u w, fderiv ℝ (fun y => fderiv ℝ H y w) z u = fderiv ℝ (fderiv ℝ H) z u w :=
    fun u w => by
      have h := (hD z).hasFDerivAt.clm_apply (hasFDerivAt_const w z)
      rw [h.fderiv]
      simp
  have hs := (hH.contDiffAt (x := z)).isSymmSndFDerivAt (by simp)
  refine Finset.sum_eq_zero fun i _ => ?_
  change fderiv ℝ (fun y => fderiv ℝ H y (0, Pi.single i 1)) z (Pi.single i 1, 0) -
    fderiv ℝ (fun y => fderiv ℝ H y (Pi.single i 1, 0)) z (0, Pi.single i 1) = 0
  rw [key, key, hs]
  ring

end Liouville

/-! ### Natural systems -/

/-- **Natural systems**: if `H_p = p/m` and `H_q = ∇U(q)` (as for `H = |p|²/(2m) + U(q)`), then
along a Hamiltonian flow `q̇ = p/m` and `m q̈ = -∇U(q)`: Newton's law. -/
theorem natural_newton {H : Observable n} (γ : HamiltonianFlow H) {m : ℝ} (hm : m ≠ 0)
    {gradU : (Fin n → ℝ) → Fin n → ℝ} (hp : ∀ q p, H.Fp q p = m⁻¹ • p)
    (hq : ∀ q p, H.Fq q p = gradU q) (t : ℝ) :
    HasDerivAt γ.q (m⁻¹ • γ.p t) t ∧
      HasDerivAt (fun s => m • (m⁻¹ • γ.p s)) (-gradU (γ.q t)) t := by
  refine ⟨hp (γ.q t) (γ.p t) ▸ γ.hasDerivAt_q t, ?_⟩
  have h := γ.hasDerivAt_p t
  rw [hq] at h
  simpa [smul_smul, mul_inv_cancel₀ hm] using h

end ClassicalMechanics
